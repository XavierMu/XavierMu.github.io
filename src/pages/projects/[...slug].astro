---
import { getCollection, getEntry, render } from 'astro:content';
import Detail from '../../layouts/Detail.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(md|mdx)$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, year, role, status, stack, repo, demo, guide } = project.data;

// 关联的使用教程：在 schema 里是 blog 集合的引用，这里换回条目本身
const guideEntry = guide ? await getEntry(guide) : undefined;
const guideHref = guideEntry ? `/blog/${guideEntry.id.replace(/\.(md|mdx)$/, '')}` : undefined;

// 链接在头部（窄屏）与左栏（宽屏）各渲染一次，内容一致
const links = [
  guideHref && { href: guideHref, label: '使用教程', icon: 'book', external: false },
  repo && { href: repo, label: '源代码', icon: 'github', external: true },
  demo && { href: demo, label: '下载 / 演示', icon: 'link', external: true },
].filter(Boolean) as { href: string; label: string; icon: string; external: boolean }[];
---

<Detail title={title} description={description}>
  <Fragment slot="rail">
    <div class="rail-block">
      <p class="rail-label kicker">项目信息</p>

      <dl class="rail-list">
        <div class="rail-item">
          <dt>年份</dt>
          <dd class="mono">{year}</dd>
        </div>
        <div class="rail-item">
          <dt>角色</dt>
          <dd>{role}</dd>
        </div>
        <div class="rail-item">
          <dt>状态</dt>
          <dd>
            <span class="status-dot" aria-hidden="true"></span>{status}
          </dd>
        </div>
        {
          stack.length > 0 && (
            <div class="rail-item">
              <dt>技术栈</dt>
              <dd class="stack">
                {stack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      {
        links.length > 0 && (
          <ul class="rail-links">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rail-link plain"
                  rel={link.external ? 'noopener' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  <Icon name={link.icon} size={13} />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Fragment>

  <header slot="header" class="project-header">
    <div class="project-head-main">
      <p class="kicker">PROJECT</p>
      <h1 class="project-title">{title}</h1>
      <p class="project-desc">{description}</p>
    </div>

    <div class="project-inline">
      <dl class="meta-grid">
        <div class="meta-item">
          <dt>年份</dt>
          <dd class="mono">{year}</dd>
        </div>
        <div class="meta-item">
          <dt>角色</dt>
          <dd>{role}</dd>
        </div>
        <div class="meta-item">
          <dt>状态</dt>
          <dd>
            <span class="status-dot" aria-hidden="true"></span>{status}
          </dd>
        </div>
        {
          stack.length > 0 && (
            <div class="meta-item meta-item--stack">
              <dt>技术栈</dt>
              <dd class="stack">
                {stack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      {
        links.length > 0 && (
          <div class="project-links">
            {links.map((link) => (
              <a
                href={link.href}
                class="btn btn--sm plain"
                rel={link.external ? 'noopener' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                <Icon name={link.icon} size={14} />
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <Content />

  <a slot="footer" href="/projects" class="back-link link-arrow plain">
    <Icon name="arrow" size={13} /> 返回项目列表
  </a>
</Detail>

<style>
  .project-header {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .project-head-main {
    min-width: 0;
  }

  /* 宽屏时年份/角色/技术栈与链接都在左栏，头部这份只留给窄屏 */
  @media (min-width: 1280px) {
    .project-inline {
      display: none;
    }
  }

  /* ---------- 左栏 ---------- */
  .rail-label {
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--fg-faint);
  }

  .rail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .rail-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.25em;
  }

  .rail-item dd {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .rail-item dd.stack {
    color: var(--fg);
  }

  .rail-links {
    list-style: none;
    padding: var(--space-3) 0 0;
    margin: var(--space-3) 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .rail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .rail-link:hover {
    color: var(--fg);
  }

  .project-title {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-cjk);
    line-height: 1.14;
    word-break: keep-all;
  }

  .project-desc {
    margin-top: var(--space-3);
    max-width: 58ch;
    font-size: var(--text-prose);
    line-height: 1.7;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  /* 项目元信息：标签在上、值在下，横排成一组，宽屏时才换行 */
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, auto));
    justify-content: start;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-5) 0 0;
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-faint);
    border-bottom: 1px solid var(--line-faint);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.4em;
  }

  .meta-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .meta-item--stack {
    grid-column: 1 / -1;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    margin-right: 0.45em;
    vertical-align: 0.05em;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .back-link {
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .project-title {
      font-size: var(--text-2xl);
    }
  }
</style>
