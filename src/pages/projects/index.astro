---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { copy } from '../../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});

// 右栏：技术栈汇总
const stackCounts = new Map<string, number>();
for (const p of projects) {
  for (const tech of p.data.stack) {
    stackCounts.set(tech, (stackCounts.get(tech) ?? 0) + 1);
  }
}
const stacks = [...stackCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// 右栏：状态分布
const byStatus = new Map<string, number>();
for (const p of projects) {
  const s = p.data.status;
  byStatus.set(s, (byStatus.get(s) ?? 0) + 1);
}
const statuses = [...byStatus.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title={copy.projects.title} description={copy.projects.description}>
  <div class="detail-grid detail-grid--left projects">
    <div class="detail-main">
      <PageHeader
        title={copy.projects.title}
        kicker={copy.projects.kicker}
        description={copy.projects.description}
        meta={copy.projects.count(projects.length)}
      />

      {
        projects.length === 0 ? (
          <p class="muted empty">{copy.projects.empty}</p>
        ) : (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} variant="full" headingLevel={2} />
            ))}
          </div>
        )
      }
    </div>

    {
      projects.length > 0 && (
        <aside class="detail-aside projects-aside">
          {stacks.length > 0 && (
            <section class="side-block">
              <h2 class="side-title kicker">{copy.projects.aside.stack}</h2>
              <ul class="side-list">
                {stacks.map(([tech, count]) => (
                  <li>
                    <span class="side-name mono">{tech}</span>
                    <span class="side-count">{count}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="side-block">
            <h2 class="side-title kicker">{copy.projects.aside.status}</h2>
            <ul class="side-list">
              {statuses.map(([status, count]) => (
                <li>
                  <span class="side-name">{status}</span>
                  <span class="side-count">{count}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block">
            <h2 class="side-title kicker">{copy.projects.aside.years}</h2>
            <ul class="side-list">
              {
                [...new Set(projects.map((p) => p.data.year))]
                  .sort((a, b) => b - a)
                  .map((year) => (
                    <li>
                      <span class="side-name mono">{year}</span>
                      <span class="side-count">
                        {projects.filter((p) => p.data.year === year).length}
                      </span>
                    </li>
                  ))
              }
            </ul>
          </section>
        </aside>
      )
    }

    <p class="back">
      <a href="/" class="link-arrow plain">
        <Icon name="arrow" size={13} /> 返回首页
      </a>
    </p>
  </div>
</Base>

<style>
  /* 与标签页、项目详情页保持同一套底部返回样式 */
  .back {
    grid-column: 1 / -1;
    margin-top: var(--space-7);
    font-size: var(--text-sm);
  }

  .project-grid {
    display: grid;
    /*
     * auto-fit 而非 auto-fill：auto-fill 会保留空轨道，
     * 只有 2 个项目时卡片被压成 1/3 宽、右侧空出一栏。
     */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }

  /* ---------- 右栏 ---------- */
  .side-block + .side-block {
    margin-top: var(--space-6);
  }

  .side-title {
    margin-bottom: var(--space-3);
  }

  .side-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .side-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .side-name {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .side-count {
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    padding-block: var(--space-7);
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
