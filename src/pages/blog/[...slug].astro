---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { entryReadingTime, locateInSeries, slugOf } from '../../utils/posts';
import { seriesDefs } from '../../data/series';

export async function getStaticPaths() {
  // getStaticPaths 在独立作用域执行，工具函数需定义在函数内部
  const slug = (id: string) => id.replace(/\.(md|mdx)$/, '');

  const all = await getCollection('blog', ({ data }) => !data.draft);
  const posts = [...all].sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  // 数组按日期倒序：索引小的更新
  return posts.map((post, i) => ({
    params: { slug: slug(post.id) },
    props: {
      post,
      // 更新的那篇（往前看）
      newer: i > 0 ? posts[i - 1] : null,
      // 更旧的那篇（往后看）
      older: i < posts.length - 1 ? posts[i + 1] : null,
      // 系列上下文：用于左栏章节导航；不属于任何系列时为 null
      series: locateInSeries(post, all, seriesDefs),
    },
  }));
}

const { post, newer, older, series } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = entryReadingTime(post);

const brief = (p: typeof post) => ({
  title: p.data.title,
  href: `/blog/${slugOf(p.id)}`,
});
---

<Post
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  readingTime={minutes}
  slug={slugOf(post.id)}
  newer={newer ? brief(newer) : null}
  older={older ? brief(older) : null}
  series={series}
>
  <Content />
</Post>
