---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { copy } from '../data/site';
import { sortByRecentlyUpdated } from '../utils/posts';

// 列出最近的几篇，给走错路的访客一个落脚点
const recent = sortByRecentlyUpdated(await getCollection('blog', ({ data }) => !data.draft)).slice(0, 3);

const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base title={copy.notFound.title} description={copy.notFound.description} noindex>
  <div class="container notfound">
    <div class="nf-main">
      <p class="kicker">ERROR 404</p>
      <p class="nf-code display" aria-hidden="true">404</p>
      <h1 class="nf-title">{copy.notFound.heading}</h1>
      <p class="nf-body">{copy.notFound.body}</p>

      <nav class="links" aria-label="常用入口">
        <a href="/" class="btn btn--primary plain">{copy.notFound.links.home}</a>
        <a href="/blog" class="btn plain">{copy.notFound.links.posts}</a>
        <a href="/archive" class="btn plain">{copy.notFound.links.archive}</a>
        <a href="/tags" class="btn plain">{copy.notFound.links.tags}</a>
      </nav>
    </div>

    {
      recent.length > 0 && (
        <section class="recent">
          <h2 class="recent-title kicker">{copy.notFound.recentTitle}</h2>
          <ul class="recent-list">
            {recent.map((post) => (
              <li>
                <a href={`/blog/${slugOf(post.id)}`} class="recent-link plain">
                  <span class="recent-name">{post.data.title}</span>
                  <Icon name="arrow" size={13} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .notfound {
    padding-block: var(--space-8) var(--space-7);
  }

  .nf-main {
    max-width: 44rem;
  }

  .nf-code {
    /* 巨大的 404 作为背景符号，靠极淡的颜色退到后面 */
    margin-top: var(--space-3);
    font-size: clamp(5rem, 16vw, 9rem);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    color: var(--fg);
    opacity: 0.08;
    letter-spacing: -0.05em;
  }

  .nf-title {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-cjk);
  }

  .nf-body {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .recent {
    max-width: 44rem;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .recent-title {
    margin-bottom: var(--space-3);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .recent-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.55em 0;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--line-faint);
    transition: color var(--duration) var(--ease);
  }

  .recent-link svg {
    flex-shrink: 0;
    opacity: 0;
    transition: opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .recent-link:hover {
    color: var(--fg);
  }

  .recent-link:hover svg {
    opacity: 1;
    transform: translateX(2px);
  }

  .recent-name {
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .notfound {
      padding-block: var(--space-6);
    }
    .links .btn {
      flex: 1 1 auto;
    }
  }
</style>
