---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

// 过滤草稿，按日期倒序
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, site.home.recentPostsCount);

// 首页只展示精选项目
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<Base isHome={true}>
  <!-- 首屏：身份 + 简介 -->
  <section class="hero container">
    <h1 class="hero-title">{site.hero.title}</h1>
    {site.hero.subtitle && <p class="hero-subtitle">{site.hero.subtitle}</p>}
    {site.hero.focus && <p class="hero-focus muted">{site.hero.focus}</p>}
    <p class="hero-intro">{site.hero.intro}</p>

    <ul class="hero-social">
      {
        site.social.map((link) => (
          <li>
            <a
              href={link.href}
              class="social-link plain"
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
            >
              <Icon name={link.icon} size={15} />
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 最近文章 -->
  {
    posts.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <h2 class="section-title">最近文章</h2>
          <a href="/blog" class="section-more plain">
            全部 <Icon name="arrow" size={14} />
          </a>
        </div>
        <div class="post-list">
          {posts.map((post) => (
            <PostList post={post} />
          ))}
        </div>
      </section>
    )
  }

  <!-- 精选项目 -->
  {
    site.home.showFeaturedProjects && projects.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <h2 class="section-title">项目</h2>
          <a href="/projects" class="section-more plain">
            全部 <Icon name="arrow" size={14} />
          </a>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} variant="compact" />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: 0 var(--space-5);
  }

  .hero-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--fg);
    margin-bottom: 0.15em;
  }

  .hero-focus {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }

  .hero-intro {
    max-width: 52ch;
    color: var(--fg-muted);
    line-height: var(--leading-body);
    margin-bottom: var(--space-3);
    text-wrap: pretty;
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .social-link:hover {
    color: var(--fg);
  }

  .section {
    margin-bottom: var(--space-6);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .section-more:hover {
    color: var(--fg);
  }

  .project-grid {
    display: grid;
    /* 与项目列表页保持一致：卡片不无限拉伸 */
    grid-template-columns: repeat(auto-fill, minmax(280px, 400px));
    gap: var(--space-2);
    justify-content: start;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-2) var(--space-5);
    }
    .hero-title {
      font-size: var(--text-2xl);
    }
    .hero-subtitle {
      font-size: var(--text-base);
    }
    .hero-social {
      gap: var(--space-2);
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
