---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import Icon from '../components/Icon.astro';
import { site, copy } from '../data/site';
import { seriesDefs } from '../data/series';
import {
  countTags,
  groupBySeries,
  groupByYear,
  readingTime,
  sortByRecentlyUpdated,
} from '../utils/posts';

const allPosts = sortByRecentlyUpdated(await getCollection('blog', ({ data }) => !data.draft));

// 最近文章：按最近更新倒序（旧文重写也算「新」）
const posts = allPosts.slice(0, site.home.recentPostsCount);

// 首页只展示精选项目
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

// 系列：首页取前三个，作为「成体系的内容」的门面
const seriesGroups = groupBySeries(allPosts, seriesDefs).slice(0, 3);

// 站点概览：文章数、标签数、总字数、起始年份
const tagList = countTags(allPosts);
const years = groupByYear(allPosts);
const firstYear = years.length > 0 ? years[years.length - 1][0] : null;
const totalMinutes = allPosts.reduce(
  (sum, p) => sum + readingTime(p.body ?? p.data.description),
  0
);

// 标签云：取前 8 个，字号随数量微缩放
const maxTagCount = Math.max(...tagList.map(([, c]) => c), 1);
const topTags = tagList.slice(0, 8);

const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, '');

// 首屏右侧「代码窗口」里展示的内容：最近一篇文章，比静态样例更诚实
const latest = allPosts[0];
const totalHours = Math.round(totalMinutes / 60);
---

<Base isHome={true}>
  <!-- ==================== 首屏 ==================== -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker kicker-dot">{site.hero.badge}</p>

        <h1 class="hero-title display">{site.hero.title}</h1>
        {site.hero.subtitle && <p class="hero-subtitle">{site.hero.subtitle}</p>}

        <p class="hero-intro">{site.hero.intro}</p>
        {
          site.hero.focus && (
            <p class="hero-focus">
              {site.hero.focus}
            </p>
          )
        }

        <div class="hero-actions">
          <a href="/blog" class="btn btn--primary plain">
            开始阅读
            <Icon name="arrow" size={15} />
          </a>
          <a href="/projects" class="btn plain">浏览项目</a>
        </div>

        <ul class="hero-facts">
          <li>
            <Icon name="book" size={14} />
            <strong>{allPosts.length}</strong> 篇文章
          </li>
          {firstYear && (
            <li>
              <Icon name="calendar" size={14} />
              始于 <strong>{firstYear}</strong>
            </li>
          )}
          <li>
            <Icon name="clock" size={14} />
            约 <strong>{totalHours || 1}</strong> 小时阅读
          </li>
        </ul>
      </div>

      <!--
        首屏右侧的「窗口」：参考站用代码窗口占据右栏，这里换成本站真实内容——
        最近一篇文章的元信息 + 正文片段，比贴一段假代码更诚实。
      -->
      <aside class="hero-panel" aria-label="最新文章">
        {
          latest && (
            <div class="panel-window">
              <div class="panel-bar">
                <span class="dot dot-r" />
                <span class="dot dot-y" />
                <span class="dot dot-g" />
                <span class="panel-bar-title mono">latest.md</span>
              </div>

              <div class="panel-body">
                <p class="panel-kicker mono">// 最近更新</p>
                {
                  latest.data.series && (
                    <a
                      href={`/series/${latest.data.series}`}
                      class="series-chip panel-series"
                    >
                      {seriesDefs.find((s) => s.id === latest.data.series)?.code ?? 'SERIES'}
                    </a>
                  )
                }
                <a href={`/blog/${slugOf(latest.id)}`} class="panel-title plain">
                  {latest.data.title}
                </a>
                <p class="panel-desc">{latest.data.description}</p>

                <ul class="panel-meta mono">
                  <li>
                    {[
                      'updatedDate' in latest.data && latest.data.updatedDate
                        ? latest.data.updatedDate
                        : latest.data.pubDate,
                    ][0]
                      .toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                        timeZone: 'Asia/Shanghai',
                      })
                      .replace(/\//g, '.')}
                  </li>
                  <li>{readingTime(latest.body ?? latest.data.description)} min</li>
                  {latest.data.tags.slice(0, 2).map((tag) => <li>#{tag}</li>)}
                </ul>

                <a href={`/blog/${slugOf(latest.id)}`} class="panel-cta btn btn--sm plain">
                  阅读全文
                  <Icon name="arrow" size={13} />
                </a>
              </div>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <!-- ==================== 最近文章 ==================== -->
  {
    posts.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div class="section-head__text">
            <p class="kicker">
              <span class="kicker-num">01</span>RECENT
            </p>
            <h2 class="section-title">{copy.home.recentPosts}</h2>
          </div>
          <a href="/blog" class="link-arrow plain">
            {copy.home.all}文章 <Icon name="arrow" size={14} />
          </a>
        </div>

        <div class="post-list">
          {posts.map((post) => (
            <PostList post={post} showTags={false} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ==================== 系列 ==================== -->
  {
    seriesGroups.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div class="section-head__text">
            <p class="kicker">
              <span class="kicker-num">02</span>SERIES
            </p>
            <h2 class="section-title">成体系的几组</h2>
            <p class="section-desc">相关文章按一条主线串起来，从第一篇读到最后。</p>
          </div>
          <a href="/series" class="link-arrow plain">
            {copy.home.all}系列 <Icon name="arrow" size={14} />
          </a>
        </div>

        <div class="series-grid">
          {seriesGroups.map((group) => (
            <SeriesCard group={group} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  <!-- ==================== 精选项目 ==================== -->
  {
    site.home.showFeaturedProjects && projects.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div class="section-head__text">
            <p class="kicker">
              <span class="kicker-num">03</span>PROJECTS
            </p>
            <h2 class="section-title">{copy.home.projects}</h2>
          </div>
          <a href="/projects" class="link-arrow plain">
            {copy.home.all}项目 <Icon name="arrow" size={14} />
          </a>
        </div>

        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  <!-- ==================== 概览 + 标签 ==================== -->
  {
    allPosts.length > 0 && (
      <section class="section container">
        <div class="overview">
          <div class="overview-stats card">
            <div class="overview-head">
              <p class="kicker">
                <span class="kicker-num">04</span>OVERVIEW
              </p>
              <h2 class="overview-title">{copy.home.overview}</h2>
            </div>

            <dl class="stats-grid">
              <div class="stat">
                <dt>{copy.home.stats.posts}</dt>
                <dd class="mono">{allPosts.length}</dd>
              </div>
              <div class="stat">
                <dt>{copy.home.stats.tags}</dt>
                <dd class="mono">{tagList.length}</dd>
              </div>
              <div class="stat">
                <dt>{copy.home.stats.reading}</dt>
                <dd class="mono">
                  {totalMinutes}<span class="unit">{copy.home.stats.minutes}</span>
                </dd>
              </div>
              {firstYear && (
                <div class="stat">
                  <dt>{copy.home.stats.since}</dt>
                  <dd class="mono">{firstYear}</dd>
                </div>
              )}
            </dl>

            <div class="overview-foot">
              <a href="/archive" class="link-arrow plain">
                按时间归档 <Icon name="arrow" size={13} />
              </a>
            </div>
          </div>

          {topTags.length > 0 && (
            <div class="overview-tags card">
              <div class="overview-head">
                <div class="overview-head-row">
                  <p class="kicker">TAGS</p>
                  <a href="/tags" class="link-arrow plain">
                    {copy.home.all} <Icon name="arrow" size={13} />
                  </a>
                </div>
                <h2 class="overview-title">标签</h2>
              </div>

              <ul class="tag-mini">
                {topTags.map(([tag, count]) => {
                  const scale = 1 + (count / maxTagCount) * 0.2;
                  return (
                    <li>
                      <a
                        href={`/blog/tag/${tag}`}
                        class="tag-mini-item"
                        style={`font-size:${scale.toFixed(2)}em`}
                      >
                        {tag}
                        <span class="tag-mini-count mono">{count}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ==================== 首屏 ==================== */
  .hero {
    padding-block: 0 var(--section-gap);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-title {
    margin-top: var(--space-4);
    /*
     * 中文大标题用 keep-all：只在标点/空格处断行。
     * 站名只有一个字时这句不生效，但站点改名后仍然安全。
     */
    word-break: keep-all;
  }

  .hero-subtitle {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .hero-intro {
    margin-top: var(--space-4);
    max-width: 46ch;
    font-size: var(--text-prose);
    line-height: var(--leading-body);
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .hero-focus {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* 事实行：图标 + 数字，等宽数字保证三组宽度稳定 */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .hero-facts svg {
    color: var(--fg-faint);
  }

  .hero-facts strong {
    font-weight: var(--weight-semi);
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* ==================== 首屏右侧窗口 ==================== */
  .hero-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .panel-window {
    border: 1px solid var(--line);
    border-radius: var(--radius-surface);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-window);
    overflow: hidden;
  }

  /* 仿窗口标题栏：三个圆点 + 文件名，呼应参考站的 mac 窗口 */
  .panel-bar {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.7em 1em;
    border-bottom: 1px solid var(--line-faint);
    background: var(--bg-subtle);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .dot-r {
    background: #ec6a5e;
  }
  .dot-y {
    background: #f4bf4f;
  }
  .dot-g {
    background: #61c554;
  }

  .panel-bar-title {
    margin-left: auto;
    font-size: var(--text-2xs);
    color: var(--fg-faint);
  }

  .panel-body {
    padding: var(--space-5);
  }

  .panel-kicker {
    font-size: var(--text-2xs);
    color: var(--fg-faint);
    letter-spacing: 0.06em;
  }

  .panel-title {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-cjk);
    line-height: 1.4;
    color: var(--fg);
    transition: color var(--duration) var(--ease);
    word-break: keep-all;
  }

  .panel-series {
    margin-top: var(--space-2);
  }

  .panel-title:hover {
    color: var(--fg-muted);
  }

  .panel-desc {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .panel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1em;
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    font-size: var(--text-2xs);
    color: var(--fg-faint);
  }

  .panel-cta {
    margin-top: var(--space-4);
  }

  /* ==================== 区块通用 ==================== */
  /*
   * 每个区块以一条发丝线开头，标题组带编号。
   * 参考站整页都靠这种极细的分隔建立秩序，比给每块套背景色克制得多。
   */
  .section {
    padding-top: var(--space-6);
    margin-bottom: var(--section-gap);
    border-top: 1px solid var(--line);
  }

  /* 区块编号：只做视觉索引，颜色压到接近分隔线 */
  .kicker-num {
    color: var(--line-strong);
    letter-spacing: 0;
  }

  .post-list {
    border-bottom: 1px solid transparent;
  }

  .project-grid {
    display: grid;
    /* auto-fit + 1fr：卡片数少于列数时均分整行，避免右侧留一大片空白 */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  /* 首页系列卡：三列等宽，窄屏自动降为单列 */
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
  }

  /* ==================== 概览 ==================== */
  .overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .overview {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-4);
      align-items: stretch;
    }
  }

  .overview-stats,
  .overview-tags {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
  }

  .overview-head {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line-faint);
  }

  .overview-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .overview-title {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: var(--weight-semi);
    letter-spacing: -0.01em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 560px) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat dt {
    font-size: var(--text-2xs);
    color: var(--fg-faint);
    letter-spacing: 0.04em;
    margin-bottom: 0.35em;
  }

  .stat dd {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: var(--weight-semi);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .stat .unit {
    font-size: var(--text-2xs);
    font-weight: var(--weight-normal);
    color: var(--fg-faint);
    margin-left: 0.25em;
    letter-spacing: 0;
  }

  .overview-foot {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  /* ==================== 首页标签 ==================== */
  .tag-mini {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.1em;
    margin-top: var(--space-4);
  }

  .tag-mini-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    color: var(--fg-muted);
    text-decoration: none;
    line-height: 1.6;
    transition: color var(--duration) var(--ease);
  }

  .tag-mini-item:hover {
    color: var(--fg);
  }

  .tag-mini-count {
    font-size: var(--text-2xs);
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 0 var(--space-7);
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .panel-body {
      padding: var(--space-4);
    }
  }
</style>
