---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getSortedPosts, countTags } from '../utils/posts';
import { copy } from '../data/site';

const posts = await getSortedPosts(getCollection);
const tags = countTags(posts);

const max = Math.max(...tags.map(([, c]) => c), 1);

// 右栏：文章最多的标签（前 5）
const topTags = tags.slice(0, 5);

// 右栏：最近被用到的标签（按最新文章出现顺序）
const recentTags: string[] = [];
for (const post of posts) {
  for (const t of post.data.tags) {
    if (!recentTags.includes(t)) recentTags.push(t);
    if (recentTags.length >= 6) break;
  }
  if (recentTags.length >= 6) break;
}
---

<Base title={copy.tags.title} description={copy.tags.description}>
  <div class="detail-grid detail-grid--left tags">
    <div class="detail-main">
      <PageHeader
        title={copy.tags.title}
        kicker={copy.tags.kicker}
        description={copy.tags.description}
        meta={copy.tags.count(tags.length)}
      />

      {
        tags.length === 0 ? (
          <p class="muted empty">{copy.tags.empty}</p>
        ) : (
          <ul class="tag-grid">
            {tags.map(([tag, count]) => {
              // 字数占比决定色条长度，比单纯的字号缩放更容易横向比较
              const ratio = Math.round((count / max) * 100);
              return (
                <li>
                  <a href={`/blog/tag/${tag}`} class="tag-tile">
                    <span class="tag-tile__top">
                      <span class="tag-name">
                        <span class="tag-hash" aria-hidden="true">#</span>
                        {tag}
                      </span>
                      <span class="tag-count mono">{count}</span>
                    </span>
                    <span class="tag-bar" aria-hidden="true">
                      <i style={`width:${ratio}%`} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>

    {
      tags.length > 0 && (
        <aside class="detail-aside tags-aside">
          <section class="side-block">
            <h2 class="side-title kicker">{copy.tags.aside.top}</h2>
            <ul class="side-list">
              {topTags.map(([tag, count]) => (
                <li>
                  <a href={`/blog/tag/${tag}`} class="side-link">
                    {tag}
                  </a>
                  <span class="side-count">{count}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block">
            <h2 class="side-title kicker">{copy.tags.aside.recent}</h2>
            <ul class="side-list">
              {recentTags.map((tag) => (
                <li>
                  <a href={`/blog/tag/${tag}`} class="side-link">
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block">
            <h2 class="side-title kicker">{copy.tags.aside.note}</h2>
            <p class="side-note">{copy.tags.note}</p>
          </section>
        </aside>
      )
    }

    <p class="back">
      <a href="/blog" class="link-arrow plain">
        <Icon name="arrow" size={13} /> 全部文章
      </a>
    </p>
  </div>
</Base>

<style>
  /* 与归档页、项目列表页保持同一套底部返回样式 */
  .back {
    grid-column: 1 / -1;
    margin-top: var(--space-7);
    font-size: var(--text-sm);
  }

  /*
   * 标签不再是单行药丸：做成等宽方格，每格一条按篇数比例的色条。
   * 单行 chip 在只有 8 个标签时会剩下一大片空白，方格能把版面铺满，
   * 横条也让「哪个标签写得最多」一眼可比。
   */
  .tag-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-3);
  }

  .tag-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
    text-decoration: none;
    color: var(--fg);
    transition: border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .tag-tile:hover {
    border-color: var(--line-strong);
    background: var(--bg-subtle);
    box-shadow: var(--shadow-xs);
  }

  .tag-tile__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tag-hash {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--fg-faint);
    margin-right: 0.15em;
  }

  .tag-name {
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-cjk);
    text-wrap: pretty;
  }

  .tag-count {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 色条：轨道用最淡的线色，填充用正文色压暗，两主题都不刺眼 */
  .tag-bar {
    display: block;
    height: 3px;
    margin-top: auto;
    border-radius: 999px;
    background: var(--line-faint);
    overflow: hidden;
  }

  .tag-bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--fg-muted);
    opacity: 0.55;
    transition: opacity var(--duration) var(--ease);
  }

  .tag-tile:hover .tag-bar i {
    opacity: 0.9;
  }

  /* ---------- 右栏 ---------- */
  .side-block + .side-block {
    margin-top: var(--space-6);
  }

  .side-title {
    margin-bottom: var(--space-3);
  }

  .side-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .side-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .side-link {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .side-link:hover {
    color: var(--fg);
  }

  .side-count {
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .side-note {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    line-height: 1.7;
  }

  .empty {
    padding-block: var(--space-7);
  }
</style>
