---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSortedPosts, countTags } from '../utils/posts';
import { copy } from '../data/site';

const posts = await getSortedPosts(getCollection);
const tags = countTags(posts);

const max = Math.max(...tags.map(([, c]) => c), 1);

// 右栏：文章最多的标签（前 5）
const topTags = tags.slice(0, 5);

// 右栏：最近被用到的标签（按最新文章出现顺序）
const recentTags: string[] = [];
for (const post of posts) {
  for (const t of post.data.tags) {
    if (!recentTags.includes(t)) recentTags.push(t);
    if (recentTags.length >= 6) break;
  }
  if (recentTags.length >= 6) break;
}
---

<Base title={copy.tags.title} description={copy.tags.description}>
  <div class="tags">
    <div class="tags-main">
      <PageHeader title={copy.tags.title} description={copy.tags.count(tags.length)} />

      {
        tags.length === 0 ? (
          <p class="muted empty">{copy.tags.empty}</p>
        ) : (
          <ul class="tag-cloud">
            {tags.map(([tag, count]) => {
              const scale = 1 + (count / max) * 0.35;
              return (
                <li>
                  <a href={`/blog/tag/${tag}`} class="tag-item">
                    <span class="tag-name" style={`font-size:${scale.toFixed(2)}em`}>
                      {tag}
                    </span>
                    <span class="tag-count mono">{count}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>

    {
      tags.length > 0 && (
        <aside class="tags-aside">
          <section class="side-block">
            <h2 class="side-title">{copy.tags.aside.top}</h2>
            <ul class="side-list">
              {topTags.map(([tag, count]) => (
                <li>
                  <a href={`/blog/tag/${tag}`} class="side-link">
                    {tag}
                  </a>
                  <span class="side-count">{count}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block">
            <h2 class="side-title">{copy.tags.aside.recent}</h2>
            <ul class="side-list">
              {recentTags.map((tag) => (
                <li>
                  <a href={`/blog/tag/${tag}`} class="side-link">
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block">
            <h2 class="side-title">{copy.tags.aside.note}</h2>
            <p class="side-note">
              {copy.tags.note}
            </p>
          </section>
        </aside>
      )
    }

    <p class="back">
      <a href="/blog" class="plain muted">← 全部文章</a>
    </p>
  </div>
</Base>

<style>
  /* 与归档页、项目列表页保持同一套底部返回样式 */
  .back {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .tags {
    width: 100%;
    max-width: var(--width-container);
    margin-inline: auto;
    padding-inline: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
  }

  @media (min-width: 768px) {
    .tags {
      padding-inline: var(--space-4);
    }
  }

  .tags-main {
    min-width: 0;
  }

  .tags-aside {
    display: none;
  }

  @media (min-width: 1280px) {
    .tags {
      grid-template-columns: minmax(0, 1fr) var(--width-aside);
      column-gap: var(--gap-aside);
      align-items: start;
    }

    .tags-aside {
      display: block;
      position: sticky;
      top: calc(64px + var(--space-4));
      font-size: var(--text-sm);
    }
  }

  .tag-cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .tag-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.5em 0.95em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--fg);
    line-height: 1.4;
    transition: border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .tag-item:hover {
    border-color: var(--line-strong);
    background: var(--bg-subtle);
  }

  .tag-name {
    font-family: var(--font-serif);
  }

  .tag-count {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  /* ---------- 右栏 ---------- */
  .side-block + .side-block {
    margin-top: var(--space-4);
  }

  .side-title {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .side-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .side-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .side-link {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-decoration-color: var(--line-strong);
    transition: color var(--duration) var(--ease);
  }

  .side-link:hover {
    color: var(--fg);
  }

  .side-count {
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .side-note {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    line-height: 1.7;
  }

  .empty {
    padding-block: var(--space-5);
  }
</style>
