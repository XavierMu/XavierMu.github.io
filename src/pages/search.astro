---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="搜索" description="站内全文搜索。">
  <div class="container">
    <PageHeader title="搜索" description="支持中文分词，输入关键词即可。" />

    <!-- Pagefind UI 挂载点 -->
    <div id="search" class="search-root"></div>

    <noscript>
      <p class="muted">搜索需要 JavaScript。你也可以直接浏览<a href="/archive">归档</a>或<a href="/tags">标签</a>。</p>
    </noscript>
  </div>
</Base>

<style>
  .search-root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: var(--fg);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-sans);
    max-width: var(--width-prose);
  }

  /* Pagefind 把输入框、清除按钮和结果列表都放在同一个 form 里。
     用 grid：第一行是「输入框 + 清除按钮」，结果列表单独占满整行。 */
  .search-root :global(.pagefind-ui__form) {
    position: relative;
    margin-bottom: var(--space-3);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 0;
  }

  .search-root :global(.pagefind-ui__form > *) {
    grid-column: 1 / -1;
  }

  .search-root :global(.pagefind-ui__form > .pagefind-ui__search-input) {
    grid-column: 1 / -1;
    grid-row: 1;
    /* 给右侧按钮留位，让按钮压在输入框内部 */
    padding-right: 4.2em;
  }

  .search-root :global(.pagefind-ui__form > .pagefind-ui__search-clear) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    margin-right: 0.35em;
    z-index: 1;
  }

  /* Pagefind 在表单里放了 ::before 做放大镜图标，这里去掉 */
  .search-root :global(.pagefind-ui__form::before) {
    display: none;
  }

  .search-root :global(.pagefind-ui__search-input) {
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    padding: 0.6em 0.8em;
    /* 给右侧的清除按钮留出空间 */
    padding-right: 4.5em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    transition: border-color var(--duration) var(--ease);
  }

  .search-root :global(.pagefind-ui__search-input:focus) {
    outline: none;
    border-color: var(--line-strong);
    box-shadow: none;
  }

  .search-root :global(.pagefind-ui__search-clear) {
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    background: transparent;
    /* 必须显式覆盖 border，否则会露出浏览器默认的 outset 立体边框 */
    border: 0;
    border-radius: var(--radius);
    padding: 0.45em 0.7em;
    line-height: 1.4;
    cursor: pointer;
    transition: color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .search-root :global(.pagefind-ui__search-clear:hover) {
    color: var(--fg);
    background: var(--bg-subtle);
  }

  .search-root :global(.pagefind-ui__search-clear:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .search-root :global(.pagefind-ui__form::before) {
    display: none;
  }

  .search-root :global(.pagefind-ui__message) {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    padding: var(--space-2) 0;
  }

  .search-root :global(.pagefind-ui__result) {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
  }

  .search-root :global(.pagefind-ui__result:last-child) {
    border-bottom: 1px solid var(--line);
  }

  .search-root :global(.pagefind-ui__result-title) {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .search-root :global(.pagefind-ui__result-title a) {
    text-decoration: none;
    color: var(--fg);
  }

  .search-root :global(.pagefind-ui__result-excerpt) {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .search-root :global(mark) {
    background: var(--bg-subtle);
    color: var(--fg);
    padding: 0 0.1em;
    border-radius: 2px;
  }

  .search-root :global(.pagefind-ui__result-nested) {
    padding-left: var(--space-2);
    border-left: 1px solid var(--line);
    margin-top: 0.5em;
  }

  /* 结果列表：去掉默认有序列表序号和缩进 */
  .search-root :global(.pagefind-ui__results) {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: none;
  }

  .search-root :global(.pagefind-ui__result) {
    list-style: none;
  }

  .search-root :global(.pagefind-ui__results > .pagefind-ui__result::before) {
    content: none;
    display: none;
  }

  .search-root :global(.pagefind-ui__result-thumb),
  .search-root :global(.pagefind-ui__result-image) {
    display: none;
  }

  .search-root :global(.pagefind-ui__result-nested .pagefind-ui__result-title::before),
  .search-root :global(.pagefind-ui__result-title::before) {
    content: none;
  }

  .search-root :global(.pagefind-ui__result-nested .pagefind-ui__result-title) {
    font-size: var(--text-base);
    font-weight: 500;
  }

  .search-root :global(.pagefind-ui__drawer) {
    border: 0;
    padding: 0;
  }
</style>

<script>
  // 渐进增强：构建产物里的 Pagefind UI 由 pagefind 生成，
  // 用运行时注入 <script> 的方式加载，避免 Vite 在构建期尝试解析。
  function loadPagefind(): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = '/pagefind/pagefind-ui.js';
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('pagefind ui not found'));
      document.head.appendChild(s);
    });
  }

  async function initSearch() {
    const root = document.getElementById('search');
    if (!root) return;

    try {
      await loadPagefind();
      // @ts-expect-error 全局由 pagefind-ui.js 挂载
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: '搜索文章…',
          zero_results: '没有找到「[SEARCH_TERM]」',
          many_results: '找到 [COUNT] 条结果',
          one_result: '找到 1 条结果',
          searching: '搜索中…',
        },
      });
    } catch {
      root.innerHTML =
        '<p style="color:var(--fg-muted);font-size:var(--text-sm)">搜索索引尚未生成。请先运行 <code>pnpm build</code>，或在浏览器里打开生产构建。</p>';
    }
  }

  initSearch();
</script>
