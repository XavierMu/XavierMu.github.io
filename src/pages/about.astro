---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="关于" description={`关于 ${site.author}，以及这个站点写了些什么。`}>
  <div class="about">
    <div class="about-main">
      <PageHeader title="关于" description="这个站写了什么，以及为什么这么写。" />

      <div class="prose about-body">
        <section>
          <h2>简介</h2>
          <p>
            我是 {site.author}。这里用来存放读过的书、写过的代码，
            以及那些当时没弄明白、后来终于想清楚的事。
          </p>
          <p>
            写作的原则很简单：写清楚自己卡在哪一步，而不是复述一份
            看起来正确的说明书。所以这里的文章多半带着具体的坑和
            不太体面的调试过程。
          </p>
        </section>

        <section>
          <h2>这里有什么</h2>
          <ul>
            <li>
              <strong>文章</strong>：读书笔记、动手时遇到的问题、
              以及一些不太成熟的思考。
            </li>
            <li>
              <strong>项目</strong>：做过的练习与实验，重点写清楚
              解决了什么问题、卡在哪里、回头会怎么改。
            </li>
          </ul>
        </section>

        <section>
          <h2>关于写作</h2>
          <ul>
            <li>不追求更新频率，宁可写得少，也要写得明白。</li>
            <li>尽量给出能复现的步骤和具体的数字，少说空话。</li>
            <li>如果发现旧文有错，会直接改，并注明更新日期。</li>
          </ul>
        </section>
      </div>
    </div>

    <!-- 右栏：联系 -->
    <aside class="about-side">
      <h2 class="side-title">联系</h2>
      <ul class="contact-list">
        {
          site.social.map((link) => (
            <li>
              <a
                href={link.href}
                class="contact-link plain"
                rel={link.href.startsWith('http') ? 'noopener' : undefined}
              >
                <Icon name={link.icon} size={15} />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="side-title">本站</h2>
      <ul class="site-info">
        <li><span class="muted">构建</span> <span class="mono">Astro</span></li>
        <li><span class="muted">托管</span> <span class="mono">GitHub Pages</span></li>
        <li><span class="muted">字体</span> <span class="mono">系统字体栈</span></li>
      </ul>
    </aside>
  </div>
</Base>

<style>
  /* 与文章/项目详情页共用同一套栅格与尺寸变量 */
  .about {
    width: 100%;
    max-width: var(--width-container);
    margin-inline: auto;
    padding-inline: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
  }

  @media (min-width: 768px) {
    .about {
      padding-inline: var(--space-4);
    }
  }

  .about-main {
    width: 100%;
    max-width: var(--width-prose);
    margin-inline: auto;
    min-width: 0;
  }

  .about-body section + section {
    margin-top: var(--space-4);
  }

  .about-body h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .about-body p + p {
    margin-top: 1em;
  }

  .about-body ul {
    padding-left: 1.2em;
  }

  .about-body li + li {
    margin-top: 0.5em;
  }

  .about-side {
    display: none;
    font-size: var(--text-sm);
  }

  @media (min-width: 1280px) {
    .about {
      /* 与 Detail 布局保持同一套栅格：正文填满 + 右栏 */
      grid-template-columns: minmax(0, 1fr) var(--width-aside);
      column-gap: var(--gap-aside);
      align-items: start;
    }

    .about-main {
      max-width: none;
      margin-inline: 0;
    }

    .about-side {
      display: block;
      position: sticky;
      top: calc(64px + var(--space-4));
    }
  }

  .side-title {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .side-title:not(:first-child) {
    margin-top: var(--space-4);
  }

  .contact-list,
  .site-info {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .contact-link:hover {
    color: var(--fg);
  }

  .site-info li {
    display: grid;
    grid-template-columns: 3.5em 1fr;
    gap: var(--space-1);
    align-items: baseline;
  }

  @media (max-width: 640px) {
    .about {
      padding-inline: var(--space-3);
    }
  }
</style>
