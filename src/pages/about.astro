---
/**
 * 关于页。
 *
 * 正文来自 `src/content/pages/about.md`，走 `.prose`——和文章页同一套排版，
 * 改文案只改那个 md 文件，不用碰模板。右栏的联系方式与站点信息仍在这里渲染，
 * 因为它们来自 site 配置、不属于「文章正文」。
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, copy } from '../data/site';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('缺少 src/content/pages/about.md，关于页无法渲染');
}

const { Content } = await render(entry);
const { title, description, updatedDate } = entry.data;

const pageDescription = description || copy.about.fallbackDescription(site.author);

/** 右栏「本站」的三项元信息：改技术栈时同步这里 */
const stack = [
  { label: '构建', value: 'Astro' },
  { label: '托管', value: 'GitHub Pages' },
  { label: '字体', value: '系统字体栈' },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Shanghai',
  });
---

<Base title={title} description={pageDescription}>
  <div class="detail-grid detail-grid--left about">
    <div class="detail-main">
      <header class="about-header">
        <p class="kicker">{copy.about.kicker}</p>
        <h1 class="about-title">{title}</h1>
        <p class="about-desc">{pageDescription}</p>
      </header>

      <div class="prose about-body">
        <Content />
      </div>
    </div>

    <aside class="detail-aside about-side">
      <section class="side-block">
        <h2 class="side-title kicker">{copy.about.aside.contact}</h2>
        <ul class="contact-list">
          {
            site.social.map((link) => {
              const isExt = link.href.startsWith('http');
              return (
                <li>
                  <a
                    href={link.href}
                    class="contact-link plain"
                    rel={isExt ? 'noopener noreferrer' : undefined}
                    target={isExt ? '_blank' : undefined}
                  >
                    <Icon name={link.icon} size={14} />
                    <span>{link.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="side-block">
        <h2 class="side-title kicker">{copy.about.aside.site}</h2>
        <ul class="site-info">
          {
            stack.map((item) => (
              <li>
                <span class="site-label">{item.label}</span>
                <span class="site-value mono">{item.value}</span>
              </li>
            ))
          }
          {
            updatedDate && (
              <li>
                <span class="site-label">更新</span>
                <span class="site-value mono">{fmt(updatedDate)}</span>
              </li>
            )
          }
        </ul>
      </section>
    </aside>
  </div>
</Base>

<style>
  /*
   * 关于页右栏没有目录，所以这里补一条竖分隔线；
   * 文章 / 项目详情页的线由 Toc.astro 自己画，不要再叠加。
   */
  @media (min-width: 1280px) {
    .about-side {
      border-left: 1px solid var(--line);
      padding-left: var(--space-5);
    }
  }

  .about-header {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .about-title {
    margin-top: var(--space-3);
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-cjk);
    line-height: 1.14;
  }

  .about-desc {
    margin-top: var(--space-3);
    max-width: 56ch;
    font-size: var(--text-prose);
    line-height: 1.7;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  .about-body > :first-child {
    margin-top: 0;
  }

  /* ---------- 右栏 ---------- */
  .side-block + .side-block {
    margin-top: var(--space-6);
  }

  .side-title {
    margin-bottom: var(--space-3);
  }

  .contact-list,
  .site-info {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .contact-link:hover {
    color: var(--fg);
  }

  .site-info li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .site-label {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .site-value {
    font-size: var(--text-2xs);
    color: var(--fg-muted);
    text-align: right;
  }
</style>
