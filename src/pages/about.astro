---
/**
 * 关于页。
 *
 * 正文来自 `src/content/pages/about.md`，走 `.prose`——和文章页同一套排版，
 * 改文案只改那个 md 文件，不用碰模板。右栏的联系方式与站点信息仍在这里渲染，
 * 因为它们来自 site 配置、不属于「文章正文」。
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, copy } from '../data/site';

const entry = await getEntry('pages', 'about');
if (!entry) {
  throw new Error('缺少 src/content/pages/about.md，关于页无法渲染');
}

const { Content } = await render(entry);
const { title, description } = entry.data;

const pageDescription = description || copy.about.fallbackDescription(site.author);

/** 右栏「本站」的三项元信息：改技术栈时同步这里 */
const stack = [
  { label: '构建', value: 'Astro' },
  { label: '托管', value: 'GitHub Pages' },
  { label: '字体', value: '系统字体栈' },
];
---

<Base title={title} description={pageDescription}>
  <div class="about">
    <div class="about-main">
      <PageHeader title={title} description={pageDescription} />

      <div class="prose about-body">
        <Content />
      </div>
    </div>

    <aside class="about-side">
      <h2 class="side-title">{copy.about.aside.contact}</h2>
      <ul class="contact-list">
        {
          site.social.map((link) => {
            const isExt = link.href.startsWith('http');
            return (
              <li>
                <a
                  href={link.href}
                  class="contact-link plain"
                  rel={isExt ? 'noopener noreferrer' : undefined}
                  target={isExt ? '_blank' : undefined}
                >
                  <Icon name={link.icon} size={15} />
                  <span>{link.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <h2 class="side-title">{copy.about.aside.site}</h2>
      <ul class="site-info">
        {
          stack.map((item) => (
            <li>
              <span class="muted">{item.label}</span>
              <span class="mono">{item.value}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>

<style>
  /* 与文章/项目详情页共用同一套栅格与尺寸变量 */
  .about {
    width: 100%;
    max-width: var(--width-container);
    margin-inline: auto;
    padding-inline: var(--space-3);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
  }

  @media (min-width: 768px) {
    .about {
      padding-inline: var(--space-4);
    }
  }

  .about-main {
    width: 100%;
    max-width: var(--width-prose);
    margin-inline: auto;
    min-width: 0;
  }

  /*
   * 正文交给 .prose 管，这里只补两处差异：
   * 1. 关于页没有文章那种「首屏大标题 + 元信息」的间距需求，首个小节贴上边
   * 2. h2 用区块级尺寸，与文章内的 h2 保持一致（.prose h2 已带下边框）
   */
  .about-body {
    margin-top: var(--space-4);
  }

  .about-body > :first-child {
    margin-top: 0;
  }

  .about-side {
    display: none;
    font-size: var(--text-sm);
  }

  @media (min-width: 1280px) {
    .about {
      /* 与 Detail 布局保持同一套栅格：正文填满 + 右栏 */
      grid-template-columns: minmax(0, 1fr) var(--width-aside);
      column-gap: var(--gap-aside);
      align-items: start;
    }

    .about-main {
      max-width: none;
      margin-inline: 0;
    }

    .about-side {
      display: block;
      position: sticky;
      top: calc(64px + var(--space-4));
    }
  }

  .side-title {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
  }

  .side-title:not(:first-child) {
    margin-top: var(--space-4);
  }

  .contact-list,
  .site-info {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .contact-link:hover {
    color: var(--fg);
  }

  .site-info li {
    display: grid;
    grid-template-columns: 3.5em 1fr;
    gap: var(--space-1);
    align-items: baseline;
  }

  @media (max-width: 640px) {
    .about {
      padding-inline: var(--space-3);
    }
  }
</style>
