---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getSortedPosts, groupByMonth, countTags } from '../utils/posts';
import { copy } from '../data/site';

const posts = await getSortedPosts(getCollection);
const grouped = groupByMonth(posts);

const MONTHS = copy.archive.months;

const fmtDay = (d: Date) => String(d.getDate()).padStart(2, '0');
const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, '');

// 右栏：每年文章数
const perYear = grouped.map(([year, months]) => ({
  year,
  count: months.reduce((n, [, list]) => n + list.length, 0),
}));
const total = posts.length;

// 右栏：全部标签（最多 8 个）
const tags = countTags(posts).slice(0, 8);
---

<Base title={copy.archive.title} description={copy.archive.description}>
  <div class="detail-grid detail-grid--left archive">
    <div class="detail-main">
      <PageHeader
        title={copy.archive.title}
        kicker={copy.archive.kicker}
        description={copy.archive.description}
        meta={copy.archive.count(posts.length)}
      />

      {
        grouped.length === 0 ? (
          <p class="muted empty">{copy.archive.empty}</p>
        ) : (
          <div class="year-blocks">
            {grouped.map(([year, months]) => (
              <section class="year-block">
                <div class="year-head">
                  <h2 class="year-title mono">{year}</h2>
                  <span class="year-count mono">
                    {months.reduce((n, [, list]) => n + list.length, 0)} 篇
                  </span>
                </div>

                {months.map(([month, list]) => (
                  <div class="month-block">
                    <h3 class="month-title">{MONTHS[month]}</h3>
                    <ul class="month-list">
                      {list.map((post) => (
                        <li>
                          <a href={`/blog/${slugOf(post.id)}`} class="entry">
                            <span class="entry-day mono">{fmtDay(post.data.pubDate)}</span>
                            <span class="entry-title">{post.data.title}</span>
                            <span class="entry-go" aria-hidden="true">
                              <Icon name="arrow" size={12} />
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </section>
            ))}
          </div>
        )
      }
    </div>

    {
      posts.length > 0 && (
        <aside class="detail-aside archive-aside">
          <section class="side-block">
            <h2 class="side-title kicker">{copy.archive.aside.years}</h2>
            <ul class="side-list">
              {perYear.map(({ year, count }) => (
                <li>
                  <span class="side-name mono">{year}</span>
                  <span class="side-count">{count}</span>
                </li>
              ))}
            </ul>
          </section>

          {
            tags.length > 0 && (
              <section class="side-block">
                <h2 class="side-title kicker">{copy.archive.aside.tags}</h2>
                <ul class="side-list">
                  {tags.map(([tag, count]) => (
                    <li>
                      <a href={`/blog/tag/${tag}`} class="side-link">
                        {tag}
                      </a>
                      <span class="side-count">{count}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section class="side-block">
            <h2 class="side-title kicker">{copy.archive.aside.stats}</h2>
            <ul class="side-list">
              <li>
                <span class="side-name">{copy.archive.statLabels.posts}</span>
                <span class="side-count">{total}</span>
              </li>
              <li>
                <span class="side-name">{copy.archive.statLabels.tags}</span>
                <span class="side-count">{tags.length}</span>
              </li>
            </ul>
          </section>
        </aside>
      )
    }

    <p class="back">
      <a href="/blog" class="link-arrow plain">
        <Icon name="arrow" size={13} /> 全部文章
      </a>
    </p>
  </div>
</Base>

<style>
  /* 与标签页、项目列表页保持同一套底部返回样式 */
  .back {
    grid-column: 1 / -1;
    margin-top: var(--space-7);
    font-size: var(--text-sm);
  }

  .year-blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .year-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-strong);
  }

  /* 年份作为分组标签，与文章列表页的年份标题保持同一套样式 */
  .year-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semi);
    color: var(--fg);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .year-count {
    font-size: var(--text-2xs);
    color: var(--fg-faint);
  }

  .month-block {
    margin-top: var(--space-4);
  }

  .month-block + .month-block {
    margin-top: var(--space-4);
  }

  .month-title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semi);
    letter-spacing: 0.06em;
    color: var(--fg-faint);
    margin-bottom: var(--space-2);
  }

  .month-list {
    list-style: none;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 1.6em minmax(0, 1fr) 1rem;
    gap: var(--space-3);
    align-items: baseline;
    padding: 0.45em 0;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--fg);
  }

  .entry:hover .entry-title {
    color: var(--fg-muted);
  }

  .entry-day {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .entry-title {
    font-size: var(--text-base);
    line-height: 1.55;
    transition: color var(--duration) var(--ease);
    text-wrap: pretty;
  }

  .entry-go {
    color: var(--fg-faint);
    opacity: 0;
    align-self: center;
    transition: opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .entry:hover .entry-go {
    opacity: 1;
    transform: translateX(2px);
  }

  /* ---------- 右栏 ---------- */
  .side-block + .side-block {
    margin-top: var(--space-6);
  }

  .side-title {
    margin-bottom: var(--space-3);
  }

  .side-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .side-list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }

  .side-link {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .side-link:hover {
    color: var(--fg);
  }

  .side-name {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .side-count {
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    padding-block: var(--space-7);
  }

  @media (max-width: 640px) {
    .entry-title {
      font-size: var(--text-sm);
    }
  }
</style>
