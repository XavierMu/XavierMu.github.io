---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSortedPosts, groupByMonth } from '../utils/posts';

const posts = await getSortedPosts(getCollection);
const grouped = groupByMonth(posts);

const MONTHS = [
  '一月', '二月', '三月', '四月', '五月', '六月',
  '七月', '八月', '九月', '十月', '十一月', '十二月',
];

const fmtDay = (d: Date) =>
  String(d.getDate()).padStart(2, '0');

const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base title="归档" description="全部文章按时间归档。">
  <div class="container">
    <PageHeader title="归档" description={`共 ${posts.length} 篇`} />

    {
      grouped.length === 0 ? (
        <p class="muted empty">还没有文章。</p>
      ) : (
        grouped.map(([year, months]) => (
          <section class="year-block">
            <h2 class="year-title mono">{year}</h2>

            {months.map(([month, list]) => (
              <div class="month-block">
                <h3 class="month-title">{MONTHS[month]}</h3>
                <ul class="month-list">
                  {list.map((post) => (
                    <li>
                      <a href={`/blog/${slugOf(post.id)}`} class="entry">
                        <span class="entry-day mono">{fmtDay(post.data.pubDate)}</span>
                        <span class="entry-title">{post.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      )
    }
  </div>
</Base>

<style>
  .year-block {
    margin-bottom: var(--space-5);
  }

  .year-title {
    font-size: var(--text-lg);
    font-family: var(--font-serif);
    font-weight: 600;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-2);
  }

  .month-block + .month-block {
    margin-top: var(--space-3);
  }

  .month-title {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    margin-bottom: 0.5em;
  }

  .month-list {
    list-style: none;
    padding: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 2.2em 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding-block: 0.4em;
    text-decoration: none;
    color: var(--fg);
  }

  .entry:hover .entry-title {
    color: var(--fg-muted);
  }

  .entry-day {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .entry-title {
    font-size: var(--text-base);
    transition: color var(--duration) var(--ease);
  }

  .empty {
    padding-block: var(--space-5);
  }

  @media (max-width: 640px) {
    .entry-title {
      font-size: var(--text-sm);
    }
  }
</style>
