---
import { site } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();

// 页脚导航：与顶栏同源，避免两处各维护一份
const links = site.nav;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-mark" aria-hidden="true"></span>
      <span class="footer-name">{site.title}</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span class="footer-copy">© {year} {site.author}</span>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      {
        links.map((link) => (
          <a href={link.href} class="footer-link plain">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="footer-social">
      {
        site.social.map((link) => {
          const isExt = link.href.startsWith('http');
          return (
            <a
              href={link.href}
              class="social-link plain"
              aria-label={link.label}
              title={link.label}
              rel={isExt ? 'noopener noreferrer' : undefined}
              target={isExt ? '_blank' : undefined}
            >
              <Icon name={link.icon} size={15} />
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="container footer-note">
    <p class="footer-text">
      本站内容按「记录过程」写成，不保证适用于所有人。
    </p>
    <a href="#top" class="footer-top plain">
      回到顶部 <Icon name="arrow" size={13} />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding-block: var(--space-6) var(--space-7);
    font-size: var(--text-sm);
    background: var(--bg);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
    flex-wrap: wrap;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--fg-faint);
    flex-wrap: wrap;
  }

  .footer-mark {
    width: 0.45em;
    height: 0.45em;
    border-radius: 2px;
    background: var(--fg);
    flex-shrink: 0;
  }

  /* 与顶栏同一个字标：衬线、略大、字距放开 */
  .footer-name {
    font-family: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', STSong,
      'SimSun', 'Georgia', serif;
    font-weight: 700;
    font-size: 1.05em;
    color: var(--fg);
    letter-spacing: 0.04em;
  }

  .footer-sep {
    color: var(--line-strong);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35em 1.15em;
  }

  .footer-link {
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .footer-link:hover {
    color: var(--fg);
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .social-link {
    color: var(--fg-muted);
    display: grid;
    place-items: center;
    padding: 0.35em;
    border-radius: var(--radius-sm);
    transition: color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .social-link:hover {
    color: var(--fg);
    background: var(--bg-subtle);
  }

  /* 第二行：一句说明 + 回顶，与顶栏的留白节奏呼应 */
  .footer-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-faint);
  }

  .footer-text {
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--fg-faint);
    font-size: var(--text-xs);
    transition: color var(--duration) var(--ease);
  }

  .footer-top svg {
    transform: rotate(-90deg);
    transition: transform var(--duration) var(--ease);
  }

  .footer-top:hover {
    color: var(--fg);
  }

  .footer-top:hover svg {
    transform: rotate(-90deg) translateX(2px);
  }

  @media (max-width: 640px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }

    .footer-social {
      order: -1;
      align-self: flex-end;
      margin-top: calc(var(--space-4) * -1);
    }
  }
</style>
