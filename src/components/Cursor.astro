---
/**
 * 自定义光标：圆点跟随鼠标，悬停可点击元素时放大。
 *
 * 只在有精细指针的设备上启用（排除触屏），并尊重「减少动效」偏好。
 */
---

<svg class="cursor-dot" id="cursor-dot" aria-hidden="true" viewBox="0 0 24 24">
  <circle cx="12" cy="12" r="11" />
</svg>

<style>
  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    /* 默认是空心圆环 */
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.2;
    transition:
      width var(--duration) var(--ease),
      height var(--duration) var(--ease),
      margin var(--duration) var(--ease),
      opacity 200ms var(--ease),
      background-color var(--duration) var(--ease),
      stroke-width var(--duration) var(--ease);
    will-change: transform;
  }

  .cursor-dot.is-visible {
    opacity: 1;
  }

  /* 悬停可点击元素：圆环缩小并变实心 */
  .cursor-dot.is-hovering {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    background: color-mix(in srgb, var(--fg) 12%, transparent);
    stroke-width: 0;
  }

  /* 按下时轻微收缩 */
  .cursor-dot.is-pressed {
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
  }

  /* 输入框等文本区域：隐藏自定义光标，交还给系统 I 型光标 */
  body.is-text-input .cursor-dot {
    opacity: 0;
  }

  /* 仅精细指针设备启用；触屏与「减少动效」时完全关闭 */
  @media (hover: none), (pointer: coarse) {
    .cursor-dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-dot {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  // 触屏或用户要求减少动效时不做任何事
  if (!reduceMotion.matches && finePointer.matches) {
    const dot = document.getElementById('cursor-dot') as HTMLElement | null;

    if (dot) {
      let raf = 0;
      let x = 0;
      let y = 0;

      const render = () => {
        raf = 0;
        dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      };

      window.addEventListener(
        'mousemove',
        (e) => {
          x = e.clientX;
          y = e.clientY;
          dot.classList.add('is-visible');
          if (!raf) raf = requestAnimationFrame(render);
        },
        { passive: true }
      );

      window.addEventListener('mouseleave', () => dot.classList.remove('is-visible'));

      // 悬停可点击元素时放大
      const CLICKABLE =
        'a, button, [role="button"], input[type="submit"], label, .toc-link, .tag-item, .nav-link';

      document.addEventListener(
        'mouseover',
        (e) => {
          const t = e.target as Element | null;
          if (t?.closest(CLICKABLE)) dot.classList.add('is-hovering');
        },
        { passive: true }
      );

      document.addEventListener(
        'mouseout',
        (e) => {
          const t = e.target as Element | null;
          const to = e.relatedTarget as Element | null;
          // 真正离开可点击区域（不是移到同区域内的子元素）时才取消
          if (t?.closest(CLICKABLE) && !to?.closest(CLICKABLE)) {
            dot.classList.remove('is-hovering');
          }
        },
        { passive: true }
      );

      // 兜底：指针不在任何可点击元素上时，随移动位置校正状态
      window.addEventListener(
        'mousemove',
        (e) => {
          const el = document.elementFromPoint(e.clientX, e.clientY);
          const hovering = !!el?.closest(CLICKABLE);
          dot.classList.toggle('is-hovering', hovering);
          const texty = !!el?.closest(
            'input:not([type="submit"]), textarea, [contenteditable="true"], .pagefind-ui__search-input'
          );
          document.body.classList.toggle('is-text-input', texty);
        },
        { passive: true }
      );

      window.addEventListener('mousedown', () => dot.classList.add('is-pressed'), { passive: true });
      window.addEventListener('mouseup', () => dot.classList.remove('is-pressed'), { passive: true });
    }
  }
</script>
