---
/**
 * 全站骨架：head、导航、页脚、主题初始化。
 * 所有页面经由本布局包裹。
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 文章/项目页传自己的标题，首页传 undefined */
  isHome?: boolean;
  /** 分享图路径，相对 public/ 或绝对 URL；不传用默认图 */
  image?: string;
  /** 页面类型，影响 OG 与 JSON-LD */
  type?: 'website' | 'article';
  /** 文章发布日期，用于 JSON-LD */
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  /** 告诉搜索引擎不要收录本页（404 这类页面用） */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  isHome = false,
  image,
  type = isHome ? 'website' : 'article',
  publishedAt,
  updatedAt,
  tags = [],
  noindex = false,
} = Astro.props;

const pageTitle = isHome ? site.title : title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;

// 分享图：页面自带优先，否则用默认图
const imagePath = image ?? '/og/default.png';
const ogImage = new URL(imagePath, site.url).href;

// 当前路径去掉末尾斜杠，供导航激活判断
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// JSON-LD：帮助搜索引擎理解页面性质
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.title,
      description: site.description,
      url: site.url,
      author: { '@type': 'Person', name: site.author },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical,
      image: ogImage,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      author: { '@type': 'Person', name: site.author },
      publisher: { '@type': 'Person', name: site.author },
      ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    };
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 结构化数据 -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- 主题：首屏前同步执行，避免深色模式闪白 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <Header currentPath={currentPath} />

    <main class="site-main">
      <slot />
    </main>

    <Footer />

    <script>
      // 主题切换：写 localStorage 并同步 data-theme
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');

      function applyTheme(theme: string) {
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch (e) {}
      }

      btn?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
      });
    </script>

    <style>
      .site-main {
        flex: 1;
        padding-block: var(--space-4) var(--space-5);
      }

      @media (max-width: 640px) {
        .site-main {
          padding-block: var(--space-3) var(--space-4);
        }
      }
    </style>
  </body>
</html>
