---
/**
 * 详情页共用骨架：正文 + 两侧栏。
 *
 * 三栏布局（≥1280px）：
 *   左栏  上下文：系列的章节导航，或「本篇文章」信息（发布 / 更新 / 阅读）
 *   中栏  正文，宽度锁在 --width-prose，在剩余空间里居中
 *   右栏  本页目录
 *
 * 三栏都固定宽度，左右留白由中栏居中自动均分——这是「分布均匀」的关键：
 * 之前中栏是 1fr、正文左对齐，正文和目录之间会留出一整条空白，
 * 而没有系列的文章只有两栏，正文挤在左边一条。
 */
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { extractHeadings } from '../utils/toc';

interface Props {
  title: string;
  description: string;
  /** 分享图，相对 public/ */
  image?: string;
  /** 文章页传 article，项目页用 website */
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
}

const { title, description, image, type = 'article', publishedAt, updatedAt, tags } =
  Astro.props;

// 先把正文渲染成字符串，才能从中提取标题生成目录
const bodyHtml = await Astro.slots.render('default');
const headings = extractHeadings(bodyHtml, 2);

/** 左栏内容由页面通过 rail 插槽提供，插槽为空时整栏不渲染 */
const hasRail = Astro.slots.has('rail');
const hasToc = headings.length >= 2;

/**
 * 正文里的外部链接统一新窗口打开。
 *
 * 为什么在构建期做、而不是用 markdown.rehypePlugins：Astro 7 的默认 Markdown
 * 处理器换成 Sätteri 后，那个钩子需要额外安装 @astrojs/markdown-remark；
 * 为一条链接属性加一个构建依赖不划算。渲染后改字符串同样零依赖，而且
 * 产物里就有 target，不依赖 JS——爬虫和禁用脚本的读者也能拿到正确行为。
 */
const SITE_HOST = 'xaviermu.github.io';

function externalLinksBlank(html: string): string {
  return html.replace(/<a\b([^>]*)>/g, (tag, attrs: string) => {
    const href = attrs.match(/\bhref="([^"]*)"/)?.[1];
    if (!href || !/^https?:\/\//i.test(href)) return tag;
    if (href.includes(SITE_HOST)) return tag;
    // 去掉作者可能已经写好的 target/rel，避免重复属性
    const rest = attrs.replace(/\s(?:target|rel)="[^"]*"/g, '');
    return `<a${rest} target="_blank" rel="noopener noreferrer">`;
  });
}

/**
 * 提示块（callout）。
 *
 * Markdown 里写 `> [!核心] 标题` 这类引用，构建时转成带样式的 div，
 * 用来标出「主线」与「可跳过」的部分——长文里读者需要一眼分辨哪些必须看。
 * 保持零依赖：这里只做字符串替换，和上面的外链处理同一个位置。
 */
const CALLOUTS: Record<string, { label: string; tone: string }> = {
  核心: { label: '核心', tone: 'core' },
  可选: { label: '可跳过', tone: 'optional' },
  注意: { label: '注意', tone: 'note' },
};

function renderCallouts(html: string): string {
  return html.replace(
    /<blockquote>([\s\S]*?)<\/blockquote>/g,
    (whole, inner: string) => {
      const match = inner.match(/^\s*<p>\s*\[!([^\]]+)\]\s*/);
      if (!match) return whole;

      const callout = CALLOUTS[match[1].trim()];
      if (!callout) return whole;

      // 摘掉开头的标记；紧随其后的第一段当作标题
      const body = inner
        .replace(/^\s*<p>\s*\[![^\]]+\]\s*/, '<p>')
        .replace(/^(\s*)<p>([\s\S]*?)<\/p>/, '$1<p class="callout-title">$2</p>');

      return [
        `<div class="callout callout-${callout.tone}">`,
        `<p class="callout-label">${callout.label}</p>`,
        body,
        '</div>',
      ].join('');
    }
  );
}

const renderedBody = renderCallouts(externalLinksBlank(bodyHtml));

const hasAside = hasToc || Astro.slots.has('aside');
---

<Base
  title={title}
  description={description}
  image={image}
  type={type}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  tags={tags}
>
  <article
    class:list={['detail-grid', 'detail', { 'has-rail': hasRail, 'has-aside': hasAside }]}
  >
    {
      hasRail && (
        <div class="detail-rail">
          <slot name="rail" />
        </div>
      )
    }

    <div class="detail-main">
      <slot name="header" />

      <div class="prose detail-body" data-pagefind-body set:html={renderedBody} />

      <footer class="detail-footer">
        <slot name="footer" />
      </footer>
    </div>

    {
      hasAside && (
        <aside class="detail-aside toc-aside">
          {hasToc && <Toc items={headings} />}
          <slot name="aside" />
        </aside>
      )
    }
  </article>
</Base>

<style>
  /*
   * 栅格随栏数变化：
   *   默认    正文单栏（居中，控制行宽）
   *   有左栏  左栏 + 正文
   *   再加目录 左栏 + 正文 + 右栏
   *
   * 三条轨道全是固定宽度，剩余空间由中栏的 margin-inline:auto 均分到两侧，
   * 所以正文和左右栏之间的间距永远相等。
   */
  .detail-rail {
    display: none;
  }

  @media (min-width: 1280px) {
    :global(.detail.has-rail) {
      grid-template-columns: var(--width-rail) minmax(0, 1fr);
    }

    :global(.detail.has-rail.has-aside) {
      grid-template-columns: var(--width-rail) minmax(0, 1fr) var(--width-toc);
    }

    /* 正文在剩余空间里居中：左右留白因此相等 */
    .detail.has-rail .detail-main {
      margin-inline: auto;
    }

    /*
     * sticky 的 top 必须等于栏目的自然位置（顶栏高 + .site-main 的上内边距），
     * 否则页面一滚动，栏目会先滑一小段再吸住——看起来像「跟着动了一下」。
     */
    .detail-rail {
      display: block;
      align-self: start;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-7));
      max-height: calc(100vh - var(--nav-height) - var(--space-7) - var(--space-5));
      overflow-y: auto;
      scrollbar-width: thin;
      /* 左栏与正文之间的分隔交给留白与网格底纹，不再画一条半截的竖线 */
      padding-right: var(--space-4);
    }
  }

  /* 两栏都在时正文很窄，目录缩到 12rem 并允许折行 */
  .detail-aside {
    font-size: var(--text-sm);
  }

  .detail-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }
</style>
