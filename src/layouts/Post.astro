---
/**
 * 文章详情页。骨架由 Detail 提供，这里只负责标题区与页脚。
 */
import Detail from './Detail.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
  newer?: { title: string; href: string } | null;
  older?: { title: string; href: string } | null;
  /** 文章 slug，用于定位分享图 /og/<slug>.png */
  slug?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  readingTime,
  newer = null,
  older = null,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Shanghai',
  });

// 文章分享图按 slug 命名，由 scripts/og.mjs 生成
const slug = Astro.props.slug;
const ogImage = slug ? `/og/${slug}.png` : undefined;
---

<Detail
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedAt={pubDate}
  updatedAt={updatedDate}
  tags={tags}
>
  <header slot="header" class="post-header">
    <h1 class="post-title">{title}</h1>

    {description && <p class="post-desc">{description}</p>}

    <div class="post-meta">
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {readingTime && (
        <span class="reading">{readingTime} 分钟阅读</span>
      )}
      {updatedDate && <span class="updated">更新于 {fmt(updatedDate)}</span>}
      {
        tags.length > 0 && (
          <span class="tags">
            {tags.map((tag) => (
              <a href={`/blog/tag/${tag}`} class="tag">
                #{tag}
              </a>
            ))}
          </span>
        )
      }
    </div>
  </header>

  <slot />

  <footer slot="footer" class="post-footer">
    {
      (newer || older) && (
        <nav class="post-nav" aria-label="文章导航">
          {newer ? (
            <a href={newer.href} class="nav-item">
              <span class="nav-dir">← 较新</span>
              <span class="nav-title">{newer.title}</span>
            </a>
          ) : (
            <span />
          )}
          {older ? (
            <a href={older.href} class="nav-item nav-next">
              <span class="nav-dir">较旧 →</span>
              <span class="nav-title">{older.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <a href="/blog" class="back-link plain">← 返回文章列表</a>
  </footer>
</Detail>

<!-- 长图在正文里限高显示，点开在这个层里按原尺寸看 -->
<dialog class="img-zoom" id="img-zoom" aria-label="放大查看图片">
  <button type="button" class="img-zoom-close" aria-label="关闭">×</button>
  <img alt="" />
</dialog>

<script>
  const zoom = document.getElementById('img-zoom') as HTMLDialogElement | null;
  const zoomImg = zoom?.querySelector('img');
  const zoomClose = zoom?.querySelector('button');

  if (zoom && zoomImg) {
    for (const img of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      img.classList.add('zoomable');
      img.addEventListener('click', () => {
        zoomImg.src = img.currentSrc || img.src;
        zoomImg.alt = img.alt;
        if (!zoom.open) zoom.showModal();
      });
    }

    // 点图片本身、点四周留白、点右上角按钮都关；Esc 由 dialog 自带。
    // 但拖动过就不算点击——长图在手机上靠拖动滚动，那一拖不该把层关掉。
    let downX = 0;
    let downY = 0;
    zoom.addEventListener('pointerdown', (event) => {
      downX = event.clientX;
      downY = event.clientY;
    });
    zoom.addEventListener('click', (event) => {
      if (Math.hypot(event.clientX - downX, event.clientY - downY) > 8) return;
      if (event.target === zoom || event.target === zoomImg) zoom.close();
    });
    zoomClose?.addEventListener('click', () => zoom.close());
  }
</script>

<style>
  .post-header {
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  /*
   * 导语：文章 description 在页面上的呈现。
   * 它原本只进 <meta>，分享卡片和搜索结果里可见，读了全文反而看不到。
   * 这里用 --fg-muted 与 --text-base，和标题（2xl/深色）、元信息（sm/更淡）拉开三档层次。
   */
  .post-desc {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .reading {
    color: var(--fg-faint);
  }

  .updated {
    color: var(--fg-faint);
  }

  .tags {
    display: flex;
    gap: 0.6em;
  }

  .tag {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-decoration-color: var(--line-strong);
    transition: color var(--duration) var(--ease);
  }

  .tag:hover {
    color: var(--fg);
  }

  /* ---------- 上下篇 ---------- */
  .post-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    text-decoration: none;
    color: var(--fg);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--duration) var(--ease);
    min-width: 0;
  }

  .nav-item:hover {
    border-color: var(--line-strong);
  }

  .nav-next {
    text-align: right;
  }

  .nav-dir {
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  .nav-title {
    font-size: var(--text-sm);
    line-height: 1.5;
    /* 长标题最多两行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .back-link {
    color: var(--fg-muted);
    transition: color var(--duration) var(--ease);
  }

  .back-link:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: var(--text-xl);
    }
    .post-nav {
      grid-template-columns: 1fr;
    }
    .nav-next {
      text-align: left;
    }
  }
</style>
