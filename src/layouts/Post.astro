---
/**
 * 文章详情页。骨架由 Detail 提供，这里只负责标题区与页脚。
 */
import Detail from './Detail.astro';
import Icon from '../components/Icon.astro';
import SeriesNav from '../components/SeriesNav.astro';
import type { SeriesDef } from '../data/series';
import type { Post as PostEntry } from '../utils/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
  newer?: { title: string; href: string } | null;
  older?: { title: string; href: string } | null;
  /** 文章 slug，用于定位分享图 /og/<slug>.png */
  slug?: string;
  /** 所属系列的上下文，用于渲染左栏章节导航 */
  series?: { def: SeriesDef; posts: PostEntry[]; index: number } | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  readingTime,
  newer = null,
  older = null,
  series = null,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Asia/Shanghai',
  });

// 文章分享图按 slug 命名，由 scripts/og.mjs 生成
const slug = Astro.props.slug;
const ogImage = slug ? `/og/${slug}.png` : undefined;
const isUpdated = Boolean(updatedDate && updatedDate.valueOf() !== pubDate.valueOf());
---

<Detail
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedAt={pubDate}
  updatedAt={updatedDate}
  tags={tags}
>
  <Fragment slot="rail">
    {series && <SeriesNav def={series.def} posts={series.posts} index={series.index} />}

    <div class="rail-block">
      <p class="rail-label kicker">本篇文章</p>
      <dl class="rail-list">
        <div class="rail-item">
          <dt>发布</dt>
          <dd>
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
          </dd>
        </div>
        {
          isUpdated && updatedDate && (
            <div class="rail-item">
              <dt>更新</dt>
              <dd>{fmt(updatedDate)}</dd>
            </div>
          )
        }
        {
          readingTime && (
            <div class="rail-item">
              <dt>阅读</dt>
              <dd>{readingTime} 分钟</dd>
            </div>
          )
        }
      </dl>
      <a href="/blog" class="rail-link link-arrow plain">
        <Icon name="arrow" size={12} /> 全部文章
      </a>
    </div>
  </Fragment>

  <header slot="header" class="post-header">
    <div class="post-head-main">
      {
        series && (
          <a
            href={`/series/${series.def.id}`}
            class:list={['series-chip', `tone-${series.def.tone}`]}
          >
            {series.def.code} · 第 {series.index + 1} / {series.posts.length} 章
          </a>
        )
      }

      {
        tags.length > 0 && (
          <ul class="post-tags">
            {tags.map((tag) => (
              <li>
                <a href={`/blog/tag/${tag}`} class="tag">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <h1 class="post-title">{title}</h1>

      {description && <p class="post-desc">{description}</p>}
    </div>

    <dl class="post-meta">
      <div class="meta-item">
        <dt>发布</dt>
        <dd>
          <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        </dd>
      </div>

      {
        isUpdated && updatedDate && (
          <div class="meta-item">
            <dt>更新</dt>
            <dd>{fmt(updatedDate)}</dd>
          </div>
        )
      }

      {
        readingTime && (
          <div class="meta-item">
            <dt>阅读</dt>
            <dd>{readingTime} 分钟</dd>
          </div>
        )
      }
    </dl>
  </header>

  <slot />

  <footer slot="footer" class="post-footer">
    {
      (newer || older) && (
        <nav class="post-nav" aria-label="文章导航">
          {newer ? (
            <a href={newer.href} class="nav-item card plain">
              <span class="nav-dir mono">
                <Icon name="arrow" size={12} /> 较新
              </span>
              <span class="nav-title">{newer.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
          {older ? (
            <a href={older.href} class="nav-item card nav-next plain">
              <span class="nav-dir mono">
                较旧 <Icon name="arrow" size={12} />
              </span>
              <span class="nav-title">{older.title}</span>
            </a>
          ) : (
            <span class="nav-spacer" />
          )}
        </nav>
      )
    }

    <a href="/blog" class="back-link link-arrow plain">
      <Icon name="arrow" size={13} /> 返回文章列表
    </a>
  </footer>
</Detail>

<!-- 长图在正文里限高显示，点开在这个层里按原尺寸看 -->
<dialog class="img-zoom" id="img-zoom" aria-label="放大查看图片">
  <button type="button" class="img-zoom-close" aria-label="关闭">×</button>
  <img alt="" />
</dialog>

<script>
  const zoom = document.getElementById('img-zoom') as HTMLDialogElement | null;
  const zoomImg = zoom?.querySelector('img');
  const zoomClose = zoom?.querySelector('button');

  if (zoom && zoomImg) {
    for (const img of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      img.classList.add('zoomable');
      img.addEventListener('click', () => {
        zoomImg.src = img.currentSrc || img.src;
        zoomImg.alt = img.alt;
        if (!zoom.open) zoom.showModal();
      });
    }

    // 点图片本身、点四周留白、点右上角按钮都关；Esc 由 dialog 自带。
    // 但拖动过就不算点击——长图在手机上靠拖动滚动，那一拖不该把层关掉。
    let downX = 0;
    let downY = 0;
    zoom.addEventListener('pointerdown', (event) => {
      downX = event.clientX;
      downY = event.clientY;
    });
    zoom.addEventListener('click', (event) => {
      if (Math.hypot(event.clientX - downX, event.clientY - downY) > 8) return;
      if (event.target === zoom || event.target === zoomImg) zoom.close();
    });
    zoomClose?.addEventListener('click', () => zoom.close());
  }
</script>

<style>
  .post-header {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .post-head-main {
    min-width: 0;
  }

  /* 系列角标与标签行互斥时也要有间距 */
  .post-head-main > .series-chip {
    margin-bottom: var(--space-4);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-cjk);
    line-height: 1.14;
    word-break: keep-all;
    text-wrap: pretty;
  }

  /*
   * 导语：文章 description 在页面上的呈现。
   * 它原本只进 <meta>，分享卡片和搜索结果里可见，读了全文反而看不到。
   * 这里用 muted 色与正文同字号，和标题（大号深色）、元信息（小号更淡）拉开三档层次。
   */
  .post-desc {
    margin-top: var(--space-4);
    max-width: 58ch;
    font-size: var(--text-prose);
    line-height: 1.7;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  /* 元信息用 dl 横排：每项是「等宽小标签 + 值」，扫描起来比一句话更快 */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-5) 0 0;
  }

  /*
   * 宽屏时元信息挪到左栏（「本篇文章」块），这里就不重复显示；
   * 窄屏没有左栏，头部这一份才是唯一的。
   */
  @media (min-width: 1280px) {
    .post-meta {
      display: none;
    }
  }

  /* ---------- 左栏 ---------- */
  .rail-block {
    margin-top: var(--space-6);
  }

  .rail-block:first-child {
    margin-top: 0;
  }

  .rail-label {
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--fg-faint);
  }

  .rail-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .rail-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.25em;
  }

  .rail-item dd {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .rail-link {
    display: inline-flex;
    margin-top: var(--space-4);
    font-size: var(--text-2xs);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 0.3em;
  }

  .meta-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 上下篇 ---------- */
  .post-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .nav-spacer {
    display: block;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.45em;
    padding: var(--space-4);
    color: var(--fg);
    min-width: 0;
  }

  .nav-item:hover {
    color: var(--fg);
  }

  .nav-next {
    text-align: right;
  }

  .nav-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }

  .nav-next .nav-dir {
    justify-content: flex-end;
  }

  .nav-title {
    font-size: var(--text-sm);
    line-height: 1.55;
    /* 长标题最多两行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .back-link {
    align-self: flex-start;
  }

  @media (max-width: 640px) {
    .post-title {
      font-size: var(--text-2xl);
    }
    .post-nav {
      grid-template-columns: 1fr;
    }
    .nav-spacer {
      display: none;
    }
    .nav-next {
      text-align: left;
    }
    .nav-next .nav-dir {
      justify-content: flex-start;
    }
  }
</style>
